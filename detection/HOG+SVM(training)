from skimage.feature import hog
import joblib, glob, os, cv2
from sklearn.svm import LinearSVC
import numpy as np

train_data = []
train_labels = []
pos_im_path = 'DATAIMAGE/positive_plus/'
neg_im_path = 'DATAIMAGE/negative_plus/'
model_path = 'model.dat'

def process_images(path, label):
    for ext in ["png", "jpg", "jpeg"]:
        for filename in glob.glob(os.path.join(path, f"*.{ext}")):
            img = cv2.imread(filename, 0)
            if img is None:
                print(f"Error reading image: {filename}. Skipping.")
                continue
            img = cv2.resize(img, (64, 128))
            features = hog(img, orientations=9, pixels_per_cell=(8,8), visualize=False, cells_per_block=(3,3))
            train_data.append(features)
            train_labels.append(label)

# Load positive images with label 1
process_images(pos_im_path, 1)

# Load negative images with label 0
process_images(neg_im_path, 0)

train_data = np.float32(train_data)
train_labels = np.array(train_labels)

print('Data Prepared........')
print('Train Data:', len(train_data))
print('Train Labels (1,0):', len(train_labels))
print("\nClassification with SVM\n")

model = LinearSVC()
print('Training...... Support Vector Machine')
model.fit(train_data, train_labels)
joblib.dump(model, model_path)
print(f'Model saved: {model_path}')
